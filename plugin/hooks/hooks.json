{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "shell": "bash", "timeout": 10, "command": "\"${AFK_GOVERNOR_EXE:-$LOCALAPPDATA/Programs/afk-governor/afk-governor.exe}\" hook session-start 2>/dev/null || true" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "shell": "bash", "timeout": 10, "command": "\"${AFK_GOVERNOR_EXE:-$LOCALAPPDATA/Programs/afk-governor/afk-governor.exe}\" hook user-prompt 2>/dev/null || true" }] }
    ],
    "PreToolUse": [
      { "matcher": "AskUserQuestion", "hooks": [{ "type": "command", "shell": "bash", "timeout": 10, "command": "\"${AFK_GOVERNOR_EXE:-$LOCALAPPDATA/Programs/afk-governor/afk-governor.exe}\" hook pre-tool-ask 2>/dev/null || true" }] }
    ]
  }
}
